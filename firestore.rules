rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 既存：大会参加・集金管理アプリのデータ（ログイン済みなら読み書きOK）
    // ※以前のルールにメールアドレス等の制限があった場合は、この1行を以前の内容に戻してください
    match /apps/{doc} {
      allow read, write: if request.auth != null;
    }

    // 支部内掲示板：ログイン済みなら誰でも投稿OK、削除は投稿者本人のみ
    match /board_posts/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // お手伝い募集：ログイン済みなら誰でも募集作成OK
    //  ・参加表明（volunteers の追加/取消）は誰でもOK
    //  ・締切・削除は募集した本人のみ
    match /helper_calls/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['volunteers']));
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // アンケート（匿名）：ログイン済みなら誰でも作成・閲覧OK
    //  ・回答は counts（集計）と voters（回答済みの人）だけを更新でき、1人1回まで
    //  ・counts と voters は別々に保存するので、誰がどれを選んだかは残らない
    //  ・締切・削除は作成した本人のみ
    match /polls/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.voters.size() == 0;
      allow update: if request.auth != null
                    && (resource.data.uid == request.auth.uid
                        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'voters'])
                            && !(request.auth.uid in resource.data.voters)
                            && request.resource.data.voters.size() == resource.data.voters.size() + 1
                            && request.auth.uid in request.resource.data.voters
                            && request.resource.data.counts.keys().hasOnly(resource.data.counts.keys())));
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
